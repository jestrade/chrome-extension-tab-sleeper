{
  "manifest_version": 3,
  "name": "Tab Sleep",
  "version": "3.0.0",
  "description": "Automatically discard inactive tabs to reduce memory usage in Chrome Stable.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "system.memory"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Sleep"
  },
  "options_page": "options.html"
}
